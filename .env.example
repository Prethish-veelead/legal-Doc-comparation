# Copy to .env and fill in. Never commit .env.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://veeleaddev.sharepoint.com/sites/LegalDocComparison
SHAREPOINT_LIBRARY=LDC_ContractDocuments
AZURE_OPENAI_ENDPOINT=https://aoai-legal-doc-compare-dev.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Part B (comparison) model; defaults to AZURE_OPENAI_DEPLOYMENT
AZURE_OPENAI_COMPARE_DEPLOYMENT=gpt-4.1-mini
# Optional
MAX_FILE_MB=20
AI_CONCURRENCY=3
